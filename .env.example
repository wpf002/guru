# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guru?schema=public"

# --- LinkedIn (Developer Portal app, tied to the Company Page) ---
# Self-serve products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Those grant: openid profile email w_member_social  → publishing works.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3001/auth/linkedin/callback"

# Commenting and reacting need w_member_social_feed, which comes from the
# Community Management API — a vetted product with a Development → Standard tier
# application, not a self-serve toggle.
#
# Leave this false until the Developer Portal shows it Approved. LinkedIn
# rejects an authorization request that names an unapproved scope, so flipping
# this early breaks sign-in entirely rather than degrading to a partial grant.
LINKEDIN_FEED_SCOPES_APPROVED="false"

# --- Token envelope encryption (roadmap §0.8) ---
# 32 random bytes, base64. Generate: openssl rand -base64 32
# In production this lives in Railway secrets and is rotated, never logged.
TOKEN_ENCRYPTION_KEY=""

# --- Google (Gmail archive watch §1.1 + Drive meeting notes §1.9) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"

# --- Model ---
ANTHROPIC_API_KEY=""

# --- Intel / peer search layer (§0.5) ---
# Tier 1 provider: exa | brave | serpapi
INTEL_SEARCH_PROVIDER="exa"
INTEL_SEARCH_API_KEY=""
# Tier 3 no-login public scraping. Off by default — business decision, not a technical one.
INTEL_TIER3_SCRAPING_ENABLED="false"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
API_PORT="3001"
