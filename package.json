{
  "name": "guru",
  "version": "0.0.0",
  "private": true,
  "description": "AI go-to-market strategist for LinkedIn",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @guru/api exec vitest run",
    "db:up": "docker start guru-postgres 2>/dev/null || docker run -d --name guru-postgres -e POSTGRES_USER=guru -e POSTGRES_PASSWORD=guru -e POSTGRES_DB=guru -p 5439:5432 postgres:16-alpine",
    "db:down": "docker stop guru-postgres",
    "db:generate": "pnpm --filter @guru/db generate",
    "db:migrate": "pnpm --filter @guru/db migrate",
    "db:studio": "pnpm --filter @guru/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
